# Local .terraform directories containing binaries
**/.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Crash logs and CLI configurations
.terraform.lock.hcl
crash.log
crash.*.log
*.tfvars
*.tfvars.json
.terraformrc
terraform.rc

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info
#ignore the .pem key files for ssh into the EC2 Server 
keys/*.pem